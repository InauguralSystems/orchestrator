#!/usr/bin/env bash
# orchestrator — run your company like code. One CLI over the whole system.
#
#   orchestrator init [dir]      scaffold a company repo (config + roster + tools)
#   orchestrator setup           onboarding agent: configure the company for you
#   orchestrator health [--local]  the scorecard (gates, hygiene, motion, backlog)
#   orchestrator standup [days]  what moved across the company
#   orchestrator sync [--install|--check|--link]  live skills <-> committed copy (+ discovery links)
#   orchestrator hire [--dry-run]  run an autonomous hiring round (HR)
#   orchestrator propose [--dry-run]  research + propose the next repo (strategy)
#   orchestrator work [--dry-run]  autonomous work session: report to the Chief of
#                                  Staff, work the backlog, escalate to propose when
#                                  dry, halt honestly when there's nothing real left
#   orchestrator perf-gate [baseline|check]  the n=5 statistical gate for perf
#                                  claims (record baseline, then check for a
#                                  confirmed non-overlapping speedup)
#   orchestrator sweep           the daily health+standup, committed
#   orchestrator doctor          check dependencies and config
#   orchestrator hook            print the PostToolUse hook JSON for settings.json
#   orchestrator version | help
set -u

PRODUCT="$(cd "$(dirname "$0")" && pwd)"
VERSION="0.1.0"

die() { echo "orchestrator: $*" >&2; exit 1; }

cmd_version() { echo "orchestrator $VERSION"; }

cmd_help() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

cmd_init() {
  local dir="${1:-$(pwd)}"; dir="$(cd "$dir" && pwd)" || die "no such dir: $1"
  [ -f "$dir/orchestrator.yaml" ] && die "orchestrator.yaml already exists in $dir (edit it, don't re-init)"
  cp "$PRODUCT/orchestrator.example.yaml" "$dir/orchestrator.yaml"
  mkdir -p "$dir/roles" "$dir/skills" "$dir/reports"
  cp -n "$PRODUCT/templates/roles/"* "$dir/roles/" 2>/dev/null || true
  cp -rn "$PRODUCT/templates/skills/"* "$dir/skills/" 2>/dev/null || true
  for f in ROSTER METRICS PORTFOLIO; do
    [ -f "$dir/$f.md" ] || cp "$PRODUCT/templates/$f.md" "$dir/$f.md" 2>/dev/null || true
  done
  cat <<EOF
Scaffolded a company in $dir

  orchestrator.yaml   <- edit this first (company, repos, vetoes)
  roles/              job charters (templates to adapt)
  skills/             your committed employees (starter triage + workflow)
  ROSTER.md METRICS.md PORTFOLIO.md   the org docs
  reports/            health history lands here

Next — let the onboarding agent do the rest for you:

  cd $dir && orchestrator sync --install   # make the starter skills live
  orchestrator setup                       # the agent configures everything

Or set it up by hand:
  1. Edit $dir/orchestrator.yaml
  2. orchestrator doctor
  3. orchestrator hook   # wire up auto-sync + cron
  4. orchestrator hire   # staff the company
  5. orchestrator health --local
EOF
}

cmd_doctor() {
  local rc=0
  echo "# orchestrator doctor"
  for bin in git awk sed jq; do
    if command -v "$bin" >/dev/null 2>&1; then echo "  [ok]   $bin"
    else echo "  [MISS] $bin (required)"; rc=1; fi
  done
  if command -v rsync >/dev/null 2>&1; then echo "  [ok]   rsync (fast skill sync)"
  else echo "  [warn] rsync not found — skill sync falls back to cp (fine, just slower)"; fi
  if command -v gh >/dev/null 2>&1; then echo "  [ok]   gh (CI + backlog signals enabled)"
  else echo "  [warn] gh not found — health/standup run in --local mode only"; fi
  if . "$PRODUCT/lib/config.sh" 2>/dev/null; then
    echo "  [ok]   config: $ORCH_CONFIG"
    echo "         company=$(orch_get company '?')  root=$(orch_expand "$(orch_get root)")"
    echo "         repos=$(orch_repos | grep -c . )  vetoes=$(orch_vetoes | grep -c . )"
  else echo "  [MISS] no orchestrator.yaml (run 'orchestrator init')"; rc=1; fi
  return $rc
}

cmd_setup() {
  . "$PRODUCT/lib/config.sh" || exit 1
  local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
  local prompt
  prompt="Onboard a new company using the company-setup skill.

The scaffold lives in $ORCH_HOME (config: $ORCH_CONFIG), currently holding
placeholder values from 'orchestrator init'. Follow the company-setup method:
discover repos under the likely root before asking, interview the founder for
only the gaps in one focused pass, write orchestrator.yaml, replace every
template placeholder in triage/workflow/ROSTER/PORTFOLIO, wire the sync hook +
cron ('orchestrator hook'), run 'orchestrator sync --install', kick off the
first hiring round ('orchestrator hire'), then verify 'orchestrator health
--local' is GREEN and hand off. Propose sensible defaults; confirm before
writing files."

  if [ "$dry" = 1 ]; then printf '%s\n' "$prompt"; return 0; fi
  if [ ! -d "$(orch_expand "$(orch_get live_skills "$HOME/.claude/skills")")/company-setup" ]; then
    echo "orchestrator: the company-setup skill isn't installed live." >&2
    echo "  Run 'orchestrator sync --install' first, or add it to ~/.claude/skills/." >&2
  fi
  if command -v claude >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec claude ${ORCH_CLAUDE_FLAGS:-} -p "$prompt"
  else
    echo "orchestrator: 'claude' CLI not found. Paste this into a Claude Code session:" >&2
    echo; printf '%s\n' "$prompt"
  fi
}

cmd_hire() {
  . "$PRODUCT/lib/config.sh" || exit 1
  local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
  local company root skills_dir roster repos
  company="$(orch_get company Company)"
  root="$(orch_expand "$(orch_get root)")"
  skills_dir="$ORCH_HOME/$(orch_get skills_dir skills)"
  roster="$(ls "$skills_dir" 2>/dev/null | tr '\n' ' ')"
  repos="$(orch_repos | sed 's/^/  - /')"
  local prompt
  prompt="Run a hiring round for the company \"$company\" using the hiring-manager skill.

Portfolio (root: $root):
$repos

Current roster (committed skills in $skills_dir):
  ${roster:-<none>}

Follow the hiring-manager method exactly: one recruiter subagent per active
repo, committee dedup across proposals, author + adversarially verify each
candidate, fire skills whose work is gone (fully autonomous), update drifted
charters, then record the round in $ORCH_HOME/ROSTER.md and reconcile the
triage roster. Default verdict is zero-hire; headcount is attention-cost."

  if [ "$dry" = 1 ]; then printf '%s\n' "$prompt"; return 0; fi
  if [ ! -d "$(orch_expand "$(orch_get live_skills "$HOME/.claude/skills")")/hiring-manager" ]; then
    echo "orchestrator: the hiring-manager skill isn't installed live." >&2
    echo "  Run 'orchestrator sync --install' first, or add it to ~/.claude/skills/." >&2
  fi
  if command -v claude >/dev/null 2>&1; then
    # ORCH_CLAUDE_FLAGS lets you set e.g. --permission-mode acceptEdits for autonomy.
    # shellcheck disable=SC2086
    exec claude ${ORCH_CLAUDE_FLAGS:-} -p "$prompt"
  else
    echo "orchestrator: 'claude' CLI not found. Paste this into a Claude Code session:" >&2
    echo; printf '%s\n' "$prompt"
  fi
}

cmd_propose() {
  . "$PRODUCT/lib/config.sh" || exit 1
  local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
  local company root repos
  company="$(orch_get company Company)"
  root="$(orch_expand "$(orch_get root)")"
  repos="$(orch_repos | sed 's/^/  - /')"
  local prompt
  prompt="Run a portfolio review for the company \"$company\" using the
portfolio-strategist skill.

Portfolio (root: $root):
$repos

Coverage map: $ORCH_HOME/PORTFOLIO.md

Follow the portfolio-strategist method: refresh PORTFOLIO.md against reality,
rank the uncovered areas, run prior-art research on the top candidate through
the deep-research skill, then write AT MOST ONE proposal using the house
contract (the gap it fills, how success is validated externally, the ledger, a
smallest-first milestone). Zero proposals is a valid outcome — do not
manufacture a project. Respect the standing vetoes. Hand the proposal to the
CEO for the go/no-go."

  if [ "$dry" = 1 ]; then printf '%s\n' "$prompt"; return 0; fi
  if [ ! -d "$(orch_expand "$(orch_get live_skills "$HOME/.claude/skills")")/portfolio-strategist" ]; then
    echo "orchestrator: the portfolio-strategist skill isn't installed live." >&2
    echo "  Run 'orchestrator sync --install' first, or add it to ~/.claude/skills/." >&2
  fi
  if command -v claude >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec claude ${ORCH_CLAUDE_FLAGS:-} -p "$prompt"
  else
    echo "orchestrator: 'claude' CLI not found. Paste this into a Claude Code session:" >&2
    echo; printf '%s\n' "$prompt"
  fi
}

# _guardrails_installed — true iff the deny-guard AND stop-gate hooks are wired
# into a settings.json the running session would load. The interlock that keeps
# 'work --permission-mode acceptEdits' from running unsupervised without a floor.
_guardrails_installed() {
  local s
  for s in "$HOME/.claude/settings.json" "$ORCH_HOME/.claude/settings.json"; do
    [ -f "$s" ] || continue
    grep -q 'deny_guard.sh' "$s" 2>/dev/null && grep -q 'stop_gate.sh' "$s" 2>/dev/null && return 0
  done
  return 1
}

cmd_work() {
  . "$PRODUCT/lib/config.sh" || exit 1
  local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
  local company root skills_dir roster repos vetoes cos
  company="$(orch_get company Company)"
  root="$(orch_expand "$(orch_get root)")"
  cos="$(orch_get chief_of_staff triage)"   # the Chief of Staff / router skill
  skills_dir="$ORCH_HOME/$(orch_get skills_dir skills)"
  roster="$(ls "$skills_dir" 2>/dev/null | tr '\n' ' ')"
  repos="$(orch_repos | sed 's/^/  - /')"
  vetoes="$(orch_vetoes | sed 's/^/  - /')"
  local prompt
  prompt="Autonomous work session for the company \"$company\". Report to the Chief
of Staff — the '$cos' skill (the triage/router; the full roster is in ROSTER.md) —
and work autonomously until told to stop or wrap.

Company root: $root
Portfolio:
$repos
Roster (live skills):
  ${roster:-<none>}
Standing vetoes — reject work that violates these, citing the veto:
$vetoes

THE LOOP — run until a human says stop/wrap, or until it is honestly dry:
1. Report to the Chief of Staff ('$cos'). Have it route the next most valuable
   piece of REAL work to exactly one owner skill, with the smallest useful next
   action.
2. Do the work through that owner and the 'workflow' operating rhythm. Every
   change passes its gates (build/tests/sanitizers) AND adversarial review
   before it lands. Trust the gate (reality: compile/run/test) over review
   (opinion) — a change that fails a gate is reverted, not limped past.
3. When the Chief of Staff has nothing real left to route, escalate to STRATEGY:
   run the portfolio-strategist 'propose' method. Research prior art + the
   coverage map, surface candidate gaps and new angles, and adversarially review
   each with DIVERSE lenses (a made-up gap must not survive a skeptic; diverse
   prompts decorrelate framing errors, the external gates catch the rest).
   Verified real gaps become new work — route them and keep going.
4. TERMINAL STATE — this is NOT a make-work machine. If 'propose' honestly finds
   nothing real (zero proposals is a valid, expected outcome — do NOT manufacture
   a project), then WRAP: summarize what was accomplished and state plainly there
   is no real work left. Stop. Do not churn, refactor what was fine, or invent
   gaps to stay busy.

DECISIONS — research before escalating to the human:
- For any decision, research the best approach first. If it is a HOW question —
  determinable, reversible, internal, within the vetoes — decide it and proceed;
  do not route it to the CEO.
- Escalate to the CEO ONLY for WHETHER questions: direction, taste, risk
  appetite, spend, or anything irreversible or outward-facing. Those stay the
  CEO's even when research could answer them — they are the CEO's because they
  are the CEO's, not because they are hard. Escalate pre-researched, with ONE
  recommendation and the evidence, never a menu.

WHEN A FIX KEEPS FAILING — reframe, don't tunnel. After repeated failed attempts
on the same break, STOP patching; more variations in the same frame won't help.
REFRAME: ask 'why did it fail?' — the diagnostic question moves you to where the
root cause is reachable that the fix-loop was tunneling past. Match the reframe to
the failure: for a nondeterministic / memory / timing bug (a heisenbug), reason
about it GEOMETRICALLY — its cause is spatial (layout, boundaries, timing
windows), not logical, so procedural tracing looks in the wrong place. Fix from
the confirmed root cause, or escalate the root cause. Trust the gate over your own
review — a model misses its own errors, so verify against reality, not belief.

WHEN YOU FIX A BREAK — capture the WHY, and prove it. The value of a fix is the
ROOT CAUSE (why it failed at first), not the patch. Capture it and prove it with a
regression test that FAILS without the fix and PASSES with it — that one act
proves the cause is real, prevents recurrence, and turns a note into a mechanical
check. Promote a load-bearing gotcha up the ladder: skill note -> regression test
-> guard/hook. Never capture a plausible-but-unproven 'why'.

CONTINUITY. You work in bounded sessions; treat context as curated, not infinite.
Keep an explicit progress/state note and use git history as the source of truth,
so a later session (or you, after compaction) can resume without re-deriving —
record what's done, what's in flight, and the open threads.

BOUNDS. There may be a hard wall-clock bound on this session; do not treat it as
the place to stop. Wrap HONESTLY well before it: land or revert cleanly, update
the progress note, and report. A bound reached mid-change is a pacing failure, not
a stopping point.

Report honestly: failed gates with output, skipped steps named as skipped, and a
clear summary when you wrap."

  if [ "$dry" = 1 ]; then printf '%s\n' "$prompt"; return 0; fi
  # Interlock: no unsupervised autonomy without the guardrail pack beneath it.
  case "${ORCH_CLAUDE_FLAGS:-}" in
    *acceptEdits*|*dangerously-skip-permissions*)
      if [ "${ORCH_UNSAFE:-0}" != "1" ] && ! _guardrails_installed; then
        die "refusing autonomous acceptEdits without the guardrail pack (deny_guard + stop_gate). Run 'orchestrator hook' and install them, or set ORCH_UNSAFE=1 to override."
      fi ;;
  esac
  if [ ! -d "$(orch_expand "$(orch_get live_skills "$HOME/.claude/skills")")/$cos" ]; then
    echo "orchestrator: the Chief of Staff skill '$cos' isn't installed live." >&2
    echo "  Run 'orchestrator sync --install', set 'chief_of_staff:' in orchestrator.yaml, or add it to your live skills." >&2
  fi
  local wt; wt="$(orch_get work_timeout 2>/dev/null || true)"
  if command -v claude >/dev/null 2>&1; then
    # ORCH_CLAUDE_FLAGS should include --permission-mode acceptEdits for autonomy.
    # work_timeout (a timeout(1) duration, e.g. 3600 or 1h) is the DETERMINISTIC
    # wall-clock bound beneath the model-judged honest-halt — so the loop cannot
    # run away even if the model never decides to stop.
    if [ -n "${wt:-}" ] && command -v timeout >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      exec timeout "$wt" claude ${ORCH_CLAUDE_FLAGS:-} -p "$prompt"
    fi
    # shellcheck disable=SC2086
    exec claude ${ORCH_CLAUDE_FLAGS:-} -p "$prompt"
  else
    echo "orchestrator: 'claude' CLI not found. Paste this into a Claude Code session:" >&2
    echo; printf '%s\n' "$prompt"
  fi
}

cmd_hook() {
  local deny="$PRODUCT/tools/deny_guard.sh"
  local gate="$PRODUCT/tools/stop_gate.sh"
  local sync="$PRODUCT/tools/hook_skill_sync.sh"
  local cfg="${ORCH_CONFIG:-$(pwd)/orchestrator.yaml}"
  cat <<EOF
The safe-autonomy guardrail pack. Merge into ~/.claude/settings.json "hooks":

{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "ORCH_CONFIG=$cfg $deny" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "ORCH_CONFIG=$cfg $gate", "timeout": 120 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit",
        "hooks": [ { "type": "command", "command": "ORCH_CONFIG=$cfg $sync" } ] }
    ]
  }
}

  PreToolUse / deny_guard — blocks force-push/delete of a protected branch and
    rm -r of a home/root path (the irreversible ops the model can't be trusted
    to never attempt). Deterministic; it cannot be talked past.
  Stop / stop_gate       — a turn cannot end with a red 'gate:' on a dirty tree,
    so an autonomous loop keeps fixing instead of stopping on red.
  PostToolUse / sync     — the committed roster stays == the live one.

'orchestrator work' with --permission-mode acceptEdits REFUSES to run unless
deny_guard + stop_gate are installed — no unsupervised autonomy without the
floor beneath it.

And add these to crontab (crontab -e):

  # daily health + standup sweep
  23 8 * * * ORCH_CONFIG=$cfg $PRODUCT/tools/daily_sweep.sh >> $(dirname "$cfg")/reports/sweep.log 2>&1

  # weekly autonomous hiring round (Mondays 09:00) — keeps the roster current
  0 9 * * 1 ORCH_CONFIG=$cfg ORCH_CLAUDE_FLAGS="--permission-mode acceptEdits" $PRODUCT/tools/hiring_round.sh >> $(dirname "$cfg")/reports/hiring.log 2>&1
EOF
}

main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    init)     cmd_init "$@";;
    setup)    cmd_setup "$@";;
    health)   . "$PRODUCT/lib/config.sh" || exit 1; exec bash "$PRODUCT/tools/health.sh" "$@";;
    standup)  . "$PRODUCT/lib/config.sh" || exit 1; exec bash "$PRODUCT/tools/standup.sh" "$@";;
    sync)     . "$PRODUCT/lib/config.sh" || exit 1; exec bash "$PRODUCT/tools/sync_skills.sh" "$@";;
    hire)     cmd_hire "$@";;
    propose)  cmd_propose "$@";;
    work)     cmd_work "$@";;
    sweep)    . "$PRODUCT/lib/config.sh" || exit 1; exec bash "$PRODUCT/tools/daily_sweep.sh" "$@";;
    perf-gate) exec bash "$PRODUCT/tools/perf_gate.sh" "$@";;
    doctor)   cmd_doctor;;
    hook)     cmd_hook;;
    version|-v|--version) cmd_version;;
    help|-h|--help) cmd_help;;
    *) die "unknown command '$sub' (try 'orchestrator help')";;
  esac
}
main "$@"
